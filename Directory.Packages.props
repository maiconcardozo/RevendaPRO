<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    EF Core 10 com o provider da Oracle (MySql.EntityFrameworkCore), como em
    source/Global/Authentication. O Pomelo ficou de fora de proposito: sua ultima versao
    estavel e a 9.0.0 e nao existe release para EF Core 10 - foi o que prendeu o CPComunica
    no EF 9 e o obrigou a copiar o EntityMap do Foundation. Ver ADR-0003.

    EF Core aqui SO gera migration e mapeia tabela. Acesso a dado e Dapper.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="MySql.Data" Version="9.6.0" />
  </ItemGroup>

  <!-- Acesso a dado: leitura e escrita. -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>

  <!-- Entity (Id + Code UUID v7 + auditoria + exclusao logica), Argon2, EntityMap. -->
  <ItemGroup>
    <PackageVersion Include="Foundation.Base" Version="3.2.0-rc.2" />
    <!--
      Required at runtime by Foundation.Shared.StringHelper (Argon2), which the package does
      not declare as a dependency. Without it the first hash throws FileNotFoundException.
    -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="MediatR" Version="14.2.0" />
  </ItemGroup>

  <!--
    FluentAssertions fica em 7.x de proposito. A partir da versao 8 o pacote passou para
    licenca Xceed, que exige licenca PAGA para uso comercial. O Revenda Pro e um produto
    comercial. A 7.2.2 e a ultima versao sob Apache 2.0.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
