ASPNETCORE_ENVIRONMENT=Development

# At least 32 characters. Generate your own; never reuse one from another environment.
REVENDAPRO_JWT_KEY=<generate-a-secure-key-with-at-least-32-characters>

REVENDAPRO_ADMIN_EMAIL=admin@revendapro.local
REVENDAPRO_ADMIN_PASSWORD=<secure-local-password>

MARIADB_DATABASE=revendapro
MARIADB_ROOT_PASSWORD=<secure-local-password>

# Senha compartilhada dos usuarios de demonstracao.
# O compose liga a criacao deles com RevendaPro__SeedDemoUsers: "true"; fora do ambiente
# local, deixe desligado.
REVENDAPRO_DEMO_PASSWORD=<secure-local-password>
