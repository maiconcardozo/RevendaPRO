# Producao. Copie para .env na maquina de producao e preencha. Este arquivo e o unico lugar
# onde a diferenca entre "local" e "publicado" existe: o codigo e o mesmo.

ASPNETCORE_ENVIRONMENT=Production

# Dominio que o Caddy vai atender e para o qual vai emitir o certificado. Sem https://.
DOMAIN=revenda.exemplo.com.br

# Pelo menos 32 caracteres. Gere um novo; jamais reaproveite o de outro ambiente.
REVENDAPRO_JWT_KEY=<gere-uma-chave-com-pelo-menos-32-caracteres>

REVENDAPRO_ADMIN_EMAIL=admin@suarevenda.com.br
REVENDAPRO_ADMIN_PASSWORD=<senha-forte>

MARIADB_DATABASE=revendapro
MARIADB_ROOT_PASSWORD=<senha-forte>

# Cloudflare R2. Dois buckets provisionados no painel (revendapro-public e revendapro-private)
# mais o de backup (revendapro-backup), e um token de API com leitura e escrita neles.
# O endpoint S3 da conta esta em R2 > Overview > "S3 API".
STORAGE_SERVICE_URL=https://<id-da-conta>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=<access-key-do-token-r2>
STORAGE_SECRET_KEY=<secret-key-do-token-r2>

# Tabela FIPE. A consulta funciona sem token (500/dia); o token gratuito sobe para 1.000/dia.
# A operacao usa dezenas de consultas por mes, entao a faixa gratuita sobra. Ver ADR-0005.
FIPE_TOKEN=

# Desligue para voltar ao valor digitado a mao, no dia em que a fonte sumir.
FIPE_ENABLED=true
